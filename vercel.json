{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/work/finscribe", "destination": "/work/finscribe-content-creation", "permanent": true },
    { "source": "/work/gather", "destination": "/work/moneyworks-client-onboarding", "permanent": true },
    { "source": "/work/website-revamp", "destination": "/work/website-redesign", "permanent": true },
    { "source": "/work/compliance-trust", "destination": "/work/finscribe-compliance-review", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}
